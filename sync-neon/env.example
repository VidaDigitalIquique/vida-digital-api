DATABASE_URL=postgresql://neondb_owner:TU_PASSWORD@TU_HOST.neon.tech/neondb?sslmode=require
# Borrado de filas obsoletas en itemdcto/movidcto (D13/D14). Por defecto, apagado:
# solo hace UPSERT y deja las filas que ya no existen en el DBF.
SYNC_DELETE_ENABLED=false
# Maximo absoluto de filas a borrar por tabla y esquema, por ejecucion.
# 0 solo permite ejecuciones sin candidatos. Un valor invalido bloquea el borrado.
SYNC_DELETE_MAX_ROWS=100
